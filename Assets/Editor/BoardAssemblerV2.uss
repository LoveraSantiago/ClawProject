#container1 {	
	display: flex;
	flex-direction: column;	
	padding-top: 10px;
	background-color:green;
}

#container2 {	
	display: flex;
	flex-direction: row;		
	background-color:red;
	padding-bottom:10px;
}

#containerListSprites {	
	display: flex;
	flex-direction: column;	
	padding-top: 10px;
	background-color:blue;
	padding-bottom:10px;
	width: auto;
}

#containerBtns {	
	display: flex;
	flex-direction: column;	
	align-self: flex-end;
	padding-top: 10px;
	background-color:green;
	flex-grow:1;
	align-items: center;
}

#containerBtnLinha{
	display: flex;
	flex-direction: row;	
}

.ctnLinha{	
	width: auto;
	flex-direction: row;	
	justify-content: center;
}

.btnDirecao {	
	height: 50px;
	width: 50px;
}

#botaoCima {
	background-image: resource('Assets/Editor/sprites/seta-cima.png');
}

#botaoEsquerda {
	margin-right: 25px;
	background-image: resource('Assets/Editor/sprites/seta-esquerda.png');
}

#botaoDireita{
	margin-left: 25px;
	background-image: resource('Assets/Editor/sprites/seta-direita.png');
}

#botaoBaixo{
	background-image: resource('Assets/Editor/sprites/seta-baixo.png');
}

.the-uxml-listview.Label {        
    
	min-width: 50px;
	width: 50px;
}

.custom {
		flex-direction: row;	
}

#VVElement {
	flex-direction: row;	
}

.unity-list-view__item	{
	flex-direction: row;
}

.unity-listview-item {
	flex-direction: row;
}

.unity-list-view__item--selected {
	flex-direction: row;
}

.custom.unity-list-view__item	{
	flex-direction: row;
}

.custom.unity-listview-item {
	flex-direction: row;
}

.custom.unity-list-view__item--selected {
	flex-direction: row;
}

.listview-item > .custom {
	flex-direction: row;
}

VisualElement.custom{
	flex-direction: row;
}

VisualElement .custom{
	flex-direction: row;
}

.mylist
{
	flex-direction: row;
}

.mylist > .custom
{
	flex-direction: row;
}

.mylist  .custom
{
	flex-direction: row;
}