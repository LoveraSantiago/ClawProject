#container1 {	
	display: flex;
	flex-direction: column;	
	padding-top: 10px;
	background-color:green;
}

#container2 {	
	display: flex;
	flex-direction: row;	
	padding-top: 10px;
	background-color:red;
}

#containerListSprites {	
	display: flex;
	flex-direction: column;	
	padding-top: 10px;
	background-color:blue;
}

#containerBtns {	
	display: flex;
	flex-direction: column;	
	align-self: flex-end;
	padding-top: 10px;
	background-color:orange;
}

#containerBtnLinha{
	display: flex;
	flex-direction: row;	
}

.ctnLinha{	
	width: auto;
	flex-direction: row;	
	justify-content: center;
}

.btnDirecao {	
	height: 50px;
	width: 50px;
}

#botaoCima {
	background-image: resource('Assets/Editor/sprites/seta-cima.png');
}

#botaoEsquerda {
	margin-right: 25px;
	background-image: resource('Assets/Editor/sprites/seta-esquerda.png');
}

#botaoDireita{
	margin-left: 25px;
	background-image: resource('Assets/Editor/sprites/seta-direita.png');
}

#botaoBaixo{
	background-image: resource('Assets/Editor/sprites/seta-baixo.png');
}

.the-uxml-listview {
    /* Provide the list view with an explict height for every row
    so it can calculate how many items to actually display */
    --unity-item-height: 16;
    height: 200px;
}
