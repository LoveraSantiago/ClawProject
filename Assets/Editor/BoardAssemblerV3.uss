#container1 {	
	display: flex;
	flex-direction: column;	
	padding-top: 10px;
	background-color:green;
}

#container2 {	
	display: flex;
	flex-direction: row;		
	background-color:red;
	padding-bottom:10px;
}

#containerBtns {	
	display: flex;
	flex-direction: column;	
	align-self: flex-end;
	padding-top: 2px;
	background-color:orange;
	flex-grow:1;
	align-items: center;
}

#containerListSprites {		
	padding-top: 10px;
	background-color:blue;
	padding-bottom:10px;	
}

#containerBtnLinha{
	display: flex;
	flex-direction: row;	
}

.ctnLinha{	
	width: auto;
	flex-direction: row;	
	justify-content: center;
}

.btnDirecao {	
	height: 50px;
	width: 50px;
}

#botaoCima {
	background-image: resource('Assets/Editor/sprites/seta-cima.png');
}

#botaoEsquerda {
	margin-right: 25px;
	background-image: resource('Assets/Editor/sprites/seta-esquerda.png');
}

#botaoDireita{
	margin-left: 25px;
	background-image: resource('Assets/Editor/sprites/seta-direita.png');
}

#botaoBaixo{
	background-image: resource('Assets/Editor/sprites/seta-baixo.png');
}

#listViewSprites {
	flex-grow: 1;
}

.veLinha {
	flex-direction: row;
	height: 40px;
	align-items: center;	
	
	border-top-left-radius:10px;
	border-top-right-radius:10px;
	border-bottom-left-radius:10px;
	border-bottom-right-radius:10px;

}

Image {
	width: 30px;
	height: 30px;
	margin-left: 30px;
}

.veLinha > Label {
	margin-left: 10px;
}

#objectFieldSprite > Label {
	min-width: 70px;
}

#main{
	min-width: 290px;
}