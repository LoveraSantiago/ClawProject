#containerCima {
	display: flex;
	flex-direction: row;		
}

#container1 {	
	display: flex;
	flex-direction: column;	
	padding-top: 10px;	
	flex-grow: 1;
	align-items: center;
}

#primeiraLinha {
	display: flex;
	flex-direction: column;	
}

#terceiraLinha {
	display: flex;
	flex-direction: column;	
}

#container1Lado {
	align-self: flex-end;
	flex-grow: 1;
}

#container2 {	
	display: flex;
	flex-direction: row;			
}

#ordem{
	margin-left: 40px;
	margin-right: 40px;
	padding-top: 10px;
}

#container3 {	
	display: flex;
	flex-direction: row;			
}

#containerBtns {	
	display: flex;
	flex-direction: column;	
	align-self: flex-end;
	padding-top: 2px;	
	flex-grow:1;
	align-items: center;
}

#containerListSprites {		
	padding-top: 10px;
	background-color:blue;
	padding-bottom:10px;	
}

#containerBtnLinha{
	display: flex;
	flex-direction: row;	
	align-items: center;
}

.ctnLinha{	
	width: auto;
	flex-direction: row;	
	justify-content: center;
}

.btnDirecao {	
	height: 50px;
	width: 50px;
}

.btnDirecaoAll {
	width: 50px;
}

#botaoCima {
	background-image: resource('Assets/Editor/sprites/seta-cima.png');
}

#botaoCimaAll {
	background-image: resource('Assets/Editor/sprites/arrow-cima.png');
}

#botaoEsquerda {
	margin-right: 25px;
	background-image: resource('Assets/Editor/sprites/seta-esquerda.png');
}

#botaoEsquerdaAll {
	background-image: resource('Assets/Editor/sprites/arrow-esquerda.png');
}

#botaoDireita{
	margin-left: 25px;
	background-image: resource('Assets/Editor/sprites/seta-direita.png');
}

#botaoDireitaAll {
	background-image: resource('Assets/Editor/sprites/arrow-direita.png');
}

#botaoBaixo{
	background-image: resource('Assets/Editor/sprites/seta-baixo.png');
}

#botaoBaixoAll {
	background-image: resource('Assets/Editor/sprites/arrow-baixo.png');
}

#listViewSprites {
	flex-grow: 1;
}

.veLinha {
	flex-direction: row;
	height: 40px;
	align-items: center;	
	
	border-top-left-radius:10px;
	border-top-right-radius:10px;
	border-bottom-left-radius:10px;
	border-bottom-right-radius:10px;
}

Image {
	width: 30px;
	height: 30px;
	margin-left: 30px;
}

.veLinha > Label {
	margin-left: 10px;
}

#objectFieldSprite{
	width: 200px;
}

#objectFieldSprite > Label {
	min-width: 70px;
}

#main{
	min-width: 290px;
}