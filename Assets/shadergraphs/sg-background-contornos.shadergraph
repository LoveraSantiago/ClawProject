        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "subidaDescida",
    "m_FunctionSource": "",
    "m_FunctionBody": "if(subida == 0){\r\n  _out = entrada;\t \r\n}\r\nelse{\r\n    _out = (entrada * -1) + frames;\t \r\n}"
}

