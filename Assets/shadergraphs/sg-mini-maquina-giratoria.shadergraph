    },
    "m_Name": "filtrarSeno (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1402.9998779296875,
            "y": 2221.0,
            "width": 213.9998779296875,
            "height": 277.999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "bb76021332234a68b2d586eb5b03d914"
        },
        {
            "m_Id": "71084c3b1e684e0a8f65879cb28a36c3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "filtrarSeno",
    "m_FunctionSource": "",
    "m_FunctionBody": "if(seno>=0)\n{\n\tsenoFiltrado=seno*24.5f;\n}\nelse\n{\n\tsenoFiltrado=(((abs(seno))*24.5f)-seno);\n}\nsenoFiltrado = senoFiltrado > 24? 24:senoFiltrado;"
}

