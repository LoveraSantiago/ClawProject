        },
        {
            "m_Id": "fe4f295891754288b09950c83402b1c7"
        },
        {
            "m_Id": "d0fc1fae7c864d39acc344c0ad065683"
        },
        {
            "m_Id": "71084c3b1e684e0a8f65879cb28a36c3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "filtrarSeno",
    "m_FunctionSource": "",
    "m_FunctionBody": "senoFiltrado=(abs(seno))*12.5f;\nsenoFiltrado=senoFiltrado>12?12:senoFiltrado;\nif(seno>0)\n{\n\ttillingX = 1;\t\n\toffsetX = 0;\n}\nelse\n{\n\ttillingX = -1;\t\t\n\toffsetX = 1;\n}"
}

