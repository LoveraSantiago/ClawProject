    \"if(seno>=0)\\n{\\n\\tsenoFiltrado=seno*24.5f;\\n}\\nelse\\n{\\n\\tsenoFiltrado=(((abs(seno))*24.5f)-seno);\\n}\\nsenoFiltrado
